{
  "name": "beacon-point-monorepo",
  "private": true,
  "workspaces": [
    "apps/web-dashboard",
    "apps/screen-player",
    "packages/ui",
    "packages/database",
    "packages/api",
    "services/ad-distribution",
    "services/marketplace"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/web-dashboard -- -H 0.0.0.0 -p 3000\" \"npm run dev --workspace services/marketplace\" \"npm run dev --workspace services/ad-distribution\"",
    "dev:backend": "cd services/backend && ../../.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8010",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "install:all": "npm install --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prisma": "^6.13.0"
  },
  "dependencies": {
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/react": "^6.1.20"
  }
}
